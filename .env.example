# Public Firebase web configuration. These identifiers are not server secrets,
# but production values must still be managed through the deployment environment.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id

# Browser origin accepted by the API. Use an exact HTTPS origin in production.
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development

# Server-side Google Cloud configuration. Never use a secret value here.
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY_SECRET=projects/replace-with-project-number/secrets/gemini-api-key/versions/1

# Optional local-only fallback. Never set this in production or expose it to Vite.
# GEMINI_API_KEY_LOCAL=
