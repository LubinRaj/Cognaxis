{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-server",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["tests", "src/client"]
}
