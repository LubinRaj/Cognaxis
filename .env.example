# Public Firebase web configuration. These identifiers are not server secrets,
# but production values must still be managed through the deployment environment.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id

# Browser origin accepted by the API. Use an exact HTTPS origin in production.
APP_ORIGIN=http://localhost:3000
PORT=3000

# Server-side Google Cloud configuration. Never use a secret value here.
GOOGLE_CLOUD_PROJECT=replace-with-project-id
GEMINI_MODEL=gemini-3.7-flash
# In production, deliver the same GEMINI_API_KEY name as a Secret Manager reference exposed
# as an environment variable on the Cloud Run service (pinned numeric version).

# Gemini API key for local development and AI Studio Preview. Production must deliver the same
# name through a Secret Manager reference on Cloud Run.
# Never expose it to Vite or the browser.
# GEMINI_API_KEY=

# Optional Gemini Enterprise Agent Platform fallback. AI Studio remains primary. On a primary
# provider failure, Agent Platform automatically reuses GOOGLE_CLOUD_PROJECT and GEMINI_MODEL above, uses the global
# endpoint, and authenticates through the Cloud Run service account. Do not add a key here.
# AGENT_PLATFORM_FALLBACK_ENABLED=false

# Google Maps JavaScript browser key. This value is compiled into the browser bundle by design;
# it is a public identifier, not a secret. Protect it with exact HTTP-referrer restrictions and
# an API restriction to the Maps JavaScript API only. Never grant it Gemini or Cloud API access.
# VITE_GOOGLE_MAPS_API_KEY=replace-with-restricted-maps-browser-key

# Narrows the frame-src content security policy to the exact Firebase auth domain in production.
# FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
# Firebase Storage bucket used for private image and document attachments. Voice recording uses a
# transient transcription request and is not retained as a raw attachment by that flow.
# FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app

# Server-enforced feature flags. Every flag defaults to enabled; set to false to disable a module
# and hide its navigation without redeploying code changes.
# FEATURE_INSIGHTS=true
# FEATURE_MAPS=true
# FEATURE_ORGANIZATIONS=true
# FEATURE_ADMIN=true
